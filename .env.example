# Nothing here is required to run locally. Every value has a working default,
# and every variable below is one the code actually reads.

# ── the model ────────────────────────────────────────────────────────────
# Leave MODEL_PROVIDER unset and it picks: Bedrock if a region and credentials
# are present, otherwise a local Ollama model if one is running. With neither it
# says so and names the two commands that would fix it.
MODEL_PROVIDER=

# Bedrock. Enable the model in the console for this region first.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Credentials come from the usual places: AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or an instance role. Never commit them.

# Local, no account. Whatever has been pulled is used unless one is named.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# ── the shop ─────────────────────────────────────────────────────────────
# One process serves one bakery. SHOP_ID puts every file under
# DATA_ROOT/SHOP_ID, so a second shop is a directory rather than six variables.
SHOP_ID=
DATA_ROOT=data
CURRENCY=€

# What a receipt cannot say: the share of the price that is ingredients. Used
# to guess costs on the first read, and every guess is marked so the owner can
# correct it.
FOOD_COST=0.30

# Set when the till export lives in S3 rather than on disk.
BILLS_BUCKET=

# ── how it reaches the owner ─────────────────────────────────────────────
# Without SES it writes to the outbox and the page shows what it would send.
OWNER_EMAIL=
SES_FROM=

# ── what it is allowed to do on its own ──────────────────────────────────
# Enforced as SDK hooks that cancel the run, not as prompt text.
MAX_TOOL_CALLS=30
MAX_RUN_COST_USD=0.15

# ── looking outward ──────────────────────────────────────────────────────
# Without a key the agent says it cannot search rather than inventing an event.
# Needs the extra as well:  pip install 'sonnabon[search]'
TAVILY_API_KEY=
SHOP_TOWN=

# ── serving ──────────────────────────────────────────────────────────────
PORT=8000
# 0.0.0.0 in a container. 127.0.0.1 refuses everything from outside it.
HOST=127.0.0.1
