# Every variable TBI reads. There are no others.

# --- backend -----------------------------------------------------------------
# false runs the agents against local Ollama and costs nothing. true runs them
# on Bedrock. Nothing else in the system changes: the tiers, the ledger and the
# gate are identical, only the model behind each tier moves.
USE_AWS=false
AWS_REGION=us-east-1
OLLAMA_HOST=http://localhost:11434

# Leave these unset and TBI uses whatever models Ollama already has: the
# smallest answers the cheap tier and the largest takes the rest. No particular
# model is required, so there is nothing to download just to try this.
#
# Set one to pin that tier, and discovery will not overrule it. Only the
# coordinator calls tools and it runs on mid, so that is the one worth pinning
# to something larger if the team lane misbehaves.
# OLLAMA_CHEAP=llama3.2:1b
# OLLAMA_MID=qwen2.5:7b
# OLLAMA_HEAVY=
# OLLAMA_MAX=

# --- money -------------------------------------------------------------------
# The highest tier execution may actually call. Routing still decides the true
# tier and the ledger still records it; this only clamps what runs.
TIER_CEILING=mid

# The model the person would otherwise have reached for. Savings are measured
# against sending the same request here, so this is the number the pitch rests
# on. Set it to whatever tab your user actually keeps open.
HABIT_TIER=max

# A whole case, agents included, that costs more than this has gone wrong.
# Enforced in a Strands hook, before the call is billed.
CASE_BUDGET_USD=0.25

# And a cap on calls, for when the model is free but looping. A full team pass
# is about six.
CASE_MAX_CALLS=14

# --- behaviour ---------------------------------------------------------------
# Below this length the router cannot recover its own cost, so the free
# keyword heuristic decides instead.
ROUTER_MIN_CHARS=400
MAX_OUTPUT_TOKENS=1024

# --- conversations -----------------------------------------------------------
# A case is a session: turns accumulate and the agent sees what was said before.
# Strands writes each one here, one directory per case.
SESSION_DIR=.sessions

# How much of a long case gets summarised away, and how many recent turns stay
# word for word. Compressing costs one cheap call and saves expensive input
# tokens on every turn after it, which is the whole trade.
SUMMARY_RATIO=0.4
KEEP_RECENT_TURNS=6

# --- storage -----------------------------------------------------------------
# Runtime settings the interface may change. Delete it to go back to the
# defaults in src/config.py.
SETTINGS_PATH=settings.json
# Leave DDB_TABLE unset to write JSONL files. Set it to use DynamoDB instead;
# nothing above that line changes.
# DDB_TABLE=tbi
LEDGER_PATH=ledger.jsonl
FEEDBACK_PATH=feedback.jsonl
