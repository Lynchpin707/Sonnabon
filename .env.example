# Nothing here is required to run locally. Every value has a working default.

# ── the model ────────────────────────────────────────────────────────────
# Bedrock, once model access is granted. Confirm the id in your own console.
USE_AWS=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Or develop against the Anthropic API while Bedrock access is pending.
ANTHROPIC_API_KEY=

# ── the shop ─────────────────────────────────────────────────────────────
CURRENCY=€
BILLS_FILE=data/bills.jsonl
TICKETS_FILE=data/tickets.json
BAKERY_CACHE=data/.cache.pkl

# Set when the till export lives in S3 rather than on disk.
BILLS_BUCKET=

# ── how it reaches the owner ─────────────────────────────────────────────
OWNER_EMAIL=
SES_FROM=

# ── what it is allowed to do on its own ──────────────────────────────────
MAX_TOOL_CALLS=30
MAX_RUN_COST_USD=0.15

# ── looking outward ──────────────────────────────────────────────────────
# Without this the agent says it cannot search rather than inventing an event.
TAVILY_API_KEY=
SHOP_TOWN=

# ── serving ──────────────────────────────────────────────────────────────
PORT=8000
# 0.0.0.0 in a container. 127.0.0.1 refuses everything from outside it.
HOST=127.0.0.1
