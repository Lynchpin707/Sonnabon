# Every variable TBI reads. There are no others.

# --- backend -----------------------------------------------------------------
# false runs the agents against local Ollama and costs nothing. true runs them
# on Bedrock. Nothing else in the system changes: the tiers, the ledger and the
# gate are identical, only the model behind each tier moves.
USE_AWS=false
AWS_REGION=us-east-1
OLLAMA_HOST=http://localhost:11434

# Which local model backs each tier. Only the coordinator calls tools, and it
# runs on the mid tier, so this is the one to raise if the team lane misbehaves
# locally. qwen2.5:7b is far more reliable at tool calling than 3b.
OLLAMA_CHEAP=qwen2.5:1.5b
OLLAMA_MID=qwen2.5:3b
OLLAMA_HEAVY=qwen2.5:3b
OLLAMA_MAX=qwen2.5:3b

# --- money -------------------------------------------------------------------
# The highest tier execution may actually call. Routing still decides the true
# tier and the ledger still records it; this only clamps what runs.
TIER_CEILING=mid

# The model the person would otherwise have reached for. Savings are measured
# against sending the same request here, so this is the number the pitch rests
# on. Set it to whatever tab your user actually keeps open.
HABIT_TIER=max

# A whole case, agents included, that costs more than this has gone wrong.
# Enforced in a Strands hook, before the call is billed.
CASE_BUDGET_USD=0.25

# And a cap on calls, for when the model is free but looping. A full team pass
# is about six.
CASE_MAX_CALLS=14

# --- behaviour ---------------------------------------------------------------
# Below this length the router cannot recover its own cost, so the free
# keyword heuristic decides instead.
ROUTER_MIN_CHARS=400
MAX_OUTPUT_TOKENS=1024

# --- storage -----------------------------------------------------------------
# Leave DDB_TABLE unset to write JSONL files. Set it to use DynamoDB instead;
# nothing above that line changes.
# DDB_TABLE=tbi
LEDGER_PATH=ledger.jsonl
FEEDBACK_PATH=feedback.jsonl
